# 複製這個檔案並改名為 .env，再填入真實的值。
# .env 已列在 .gitignore，不會被上傳到 GitHub。
# 注意：這個儲存庫是公開的（Public），真實金鑰只能放在 .env 與 Vercel 後台。
# 這些變數只給後端（api/）使用，不可以加上 VITE_、NEXT_PUBLIC_ 等會被放進前端的前綴。

# ===== Gemini（每人到 Google AI Studio 建立自己的免費金鑰）=====
GEMINI_API_KEY=

# ===== Firebase 服務帳戶（只有張○誠與 Vercel 後台需要）=====
# Firebase 主控台 → 專案設定 → 服務帳戶 → 產生新的私密金鑰
# 下載的 JSON 檔不要放進專案資料夾，只把裡面三個值抄到這裡。
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ===== 用量控管 =====
# 每位學生每天最多呼叫 AI 幾次（全班共用同一個免費額度）
AI_DAILY_LIMIT_PER_STUDENT=50

# ===== 本機開發 =====
# 這一項只在本機使用，Vercel 後台不要設定。
# 1 = 使用假資料，不連線 Firebase（沒有服務帳戶金鑰的組員請設 1）
USE_FAKE_DB=1
